rules_version = '2';

// The browser never talks to Firestore. It talks to the API, which verifies the
// Firebase ID token, checks the email allowlist, and enforces that a job may
// only be read by the uid that created it.
//
// So this file denies everything. That is not belt-and-braces on top of the
// handler check — it is the statement that there is no client-side data path at
// all. Cloud Run reaches Firestore with the fbc-review-sa service account,
// which is an admin credential and is not subject to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
