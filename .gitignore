# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Secrets — never commit.
# The directory is excluded by contents rather than as a whole: git cannot
# re-include a file whose parent directory is excluded, and the template and
# the README have to be committable for the variable names to live in the
# repository rather than in somebody's head.
secrets/*
!secrets/README.md
!secrets/*.example
*firebase-sa*.json
.env
.env.*
*-service-account*.json
*serviceAccountKey*.json
.firebaserc.local
.cloudflared/
cert.pem

# Node / Angular
node_modules/
web/dist/
.angular/

# Local artefacts
/out/
.devdata/
samples/
*.pdf
!docs/**/*.pdf

# Client drawings are never committed, wherever they land — the same rule as a
# client PDF. A DWG or DXF is the drafter's whole model, not a plot of it, and a
# DXF converted from one is 7x the size. Tests build their drawings in code
# with ezdxf. A zip is either an uploaded set of drawings with their xrefs or
# the marked-up DXF the review writes back (python -m fbcreview.cad markup), so
# it goes too. Also AutoCAD's lock and autosave files, and Revit/IFC models,
# for when that path exists.
*.dwg
*.dxf
*.dwf
*.dwfx
*.dwt
*.dwl
*.dwl2
*.sv$
*.zip
*.rvt
*.rfa
*.ifc
*.ifczip

# Firebase CLI artefacts
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
.firebase/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
